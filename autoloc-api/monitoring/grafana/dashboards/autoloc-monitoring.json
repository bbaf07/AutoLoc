{
  "uid": "autoloc-monitoring",
  "title": "AutoLoc — Application Monitoring",
  "schemaVersion": 39,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Mémoire JVM utilisée",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-autoloc"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-autoloc"
          },
          "expr": "sum(jvm_memory_used_bytes{application=\"autoloc-api\"}) by (area)",
          "legendFormat": "{{area}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Utilisation CPU du processus",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-autoloc"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-autoloc"
          },
          "expr": "process_cpu_usage{application=\"autoloc-api\"}",
          "legendFormat": "CPU"
        }
      ]
    },
    {
      "id": 3,
      "title": "Requêtes HTTP par seconde",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-autoloc"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-autoloc"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"autoloc-api\"}[1m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Temps de réponse HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-autoloc"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-autoloc"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"autoloc-api\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "title": "Threads JVM actifs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-autoloc"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-autoloc"
          },
          "expr": "jvm_threads_live_threads{application=\"autoloc-api\"}",
          "legendFormat": "threads"
        }
      ]
    },
    {
      "id": 6,
      "title": "Réponses 401 / 403 par minute",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-autoloc"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-autoloc"
          },
          "expr": "sum(increase(http_server_requests_seconds_count{application=\"autoloc-api\",status=~\"401|403\"}[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ],
  "tags": [
    "autoloc",
    "spring-boot"
  ]
}